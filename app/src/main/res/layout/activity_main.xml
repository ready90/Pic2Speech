<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <!-- 首次使用提示：没有内置 Key，必须自己填一次才看得见 -->
        <TextView
            android:id="@+id/keyNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_notice"
            android:lineSpacingExtra="2dp"
            android:padding="10dp"
            android:text="@string/key_notice"
            android:textColor="@color/warn_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ① 选择图片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pick" />

            <TextView
                android:id="@+id/tvPick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/not_picked"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ② 语言与音色 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_lang"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/label_voice"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 模式与篇幅 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/label_mode"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/label_detail"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 语速 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_rate"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="60"
                android:progress="30" />

            <TextView
                android:id="@+id/tvRate"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0%"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- API Key -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="智谱 API Key"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save_key" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvKeyMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/generate" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/label_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/text_hint"
            android:inputType="textMultiLine"
            android:minLines="6"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResynth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/resynth"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/play"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/share"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================= 播放器面板 =================
             生成出音频后才显示；进度可拖动、可调倍速、可暂停继续 -->
        <LinearLayout
            android:id="@+id/playerBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_player"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/player_time"
                android:textColor="@color/brand_dark"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/sbPos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBack5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:text="@string/back5"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnFwd5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:text="@string/fwd5"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnExternal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:text="@string/open_player"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_speed"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:max="15"
                    android:progress="5" />

                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/player_speed_val"
                    android:textColor="@color/brand_dark"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="@color/muted" />

    </LinearLayout>
</ScrollView>
